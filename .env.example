# Defaults work without any paid key. Copy this file to .env in the repository root.
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
MOCK_PROVIDERS=1
LLM_PROVIDER=mock
# Free local alternative: set MOCK_PROVIDERS=0, LLM_PROVIDER=ollama.
# Run Ollama separately with OLLAMA_NO_CLOUD=1 and install a model yourself.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT_MS=8000
# Required for production; use a random secret of at least 32 bytes.
SERVER_SECRET=
ACCESS_CODE=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_MODEL_LATER_ROUNDS=claude-sonnet-5
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ENABLED_LANGS=ta,en
