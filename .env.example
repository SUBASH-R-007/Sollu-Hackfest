# Defaults work without any paid key. Copy this file to .env in the repository root.
PORT=8787
PUBLIC_ORIGIN=http://localhost:5173
MOCK_PROVIDERS=1
LLM_PROVIDER=mock
# Privacy default: cloud sentence AI is BLOCKED at the server and adapter.
# Existing keys, saved choices and browser consent cannot override this policy.
# Keep 0 for local-only use. Changing to 1 is a deliberate deployment policy
# change, requiring separate privacy/legal review; it does NOT establish HIPAA,
# PHI protection or medical-device compliance. Restart the server after changes.
ALLOW_CLOUD_AI=0
# Free vocabulary and loopback Ollama are available with no API key.
# If cloud is explicitly permitted by the operator, each device must also grant
# text-sharing permission in caregiver Settings before any cloud request.
# Supported: mock, openai, anthropic, gemini, groq, ollama.
# LLM_MODEL overrides the cloud default only. Leave blank for provider defaults.
LLM_MODEL=
OPENAI_API_KEY=
# Voice flow "High accuracy" transcription model (default gpt-4o-transcribe).
OPENAI_TRANSCRIBE_MODEL=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
# Alternatively enter a key in caregiver Settings: server memory only, scoped
# to that browser's authenticated device; expires after 12h inactivity/restart.
# Free local alternative: keep ALLOW_CLOUD_AI=0; set MOCK_PROVIDERS=0, LLM_PROVIDER=ollama.
# Run Ollama separately with OLLAMA_NO_CLOUD=1 and install a model yourself.
# The app cannot control that separate process or the browser's speech vendor.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
LLM_TIMEOUT_MS=15000
# Required for production; use a random secret of at least 32 bytes.
SERVER_SECRET=
ACCESS_CODE=
# Where the server keeps voice-deletion records so a withdrawn voice stays
# withdrawn after restarts. Defaults to .sollu-data in production (git-ignored);
# unset in development, where the signing secret changes on every start.
SOLLU_DATA_DIR=
# Speech/voice adapters below remain unimplemented placeholders.
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
ENABLED_LANGS=ta,en
